# PostgreSQL (Neon) connection string
# Neon dashboard -> Connect -> copy the pooled connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Any long random string works.
SESSION_SECRET="replace-with-a-long-random-string"

# --- Payments (Razorpay, test mode) ---
# Leave these unset to run the app with fees collected at the clinic ("manual"
# provider). Set the first two to switch every new booking to online checkout.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="replace-with-razorpay-key-secret"
# Optional backstop: a signature-verified webhook (dashboard -> Settings ->
# Webhooks, subscribed to payment.captured / payment.failed / refund.processed /
# refund.failed, pointed at https://<host>/api/webhooks/razorpay) that settles
# payments arriving out-of-band, e.g. a refund that the gateway settles
# asynchronously. Checkout confirmation verifies each payment directly with the
# gateway API, so the core booking/checkout/refund flows do not require it.
RAZORPAY_WEBHOOK_SECRET="replace-with-razorpay-webhook-secret"

# Authenticates Vercel Cron calls to /api/cron/daily-sweep.
CRON_SECRET="replace-with-a-long-random-string"

# --- Notifications (email via Resend) ---
# Leave unset to run with a log-only transport: every notification that would
# have been emailed is printed to the server log in full instead.
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Optional. Defaults to "Medrella <onboarding@resend.dev>", which only delivers
# to your own Resend account until a sending domain is verified.
RESEND_FROM="Medrella <appointments@yourdomain.com>"
# Absolute origin used for links inside emails (dashboard and receipt buttons).
# Optional: falls back to VERCEL_URL (so a preview links to itself), then
# http://localhost:3000. Set it to the public URL in production.
APP_URL="https://your-app.example.com"

# --- Notifications (mobile: WhatsApp + SMS via Twilio) ---
# Leave the SID/token unset to run without mobile messages: patients who opted
# in get email only, and the attempts are recorded on the ledger as not
# delivered.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="replace-with-twilio-auth-token"
# WhatsApp is template-only: it kicks in when BOTH vars below are set - an
# approved Content Template carrying the visit date in {{1}} and the visit
# time in {{2}}. Kinds the template cannot say (payment, refund, cancellation,
# care) ride SMS instead. The Content sid may be pasted with surrounding
# quotes/whitespace or as "ContentSid=HX..." - it is normalized on read.
TWILIO_WHATSAPP_FROM="+17372508034"
TWILIO_WHATSAPP_CONTENT_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SMS sender, E.164. Carries every message kind without a WhatsApp template.
TWILIO_FROM="+14155550123"
